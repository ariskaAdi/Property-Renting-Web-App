model room_availability {
  id             String   @id @default(uuid())
  room_id        String
  date           DateTime @db.Date
  is_available   Boolean
  price_override Decimal? @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
